@router.get("/models/config")
def api_models_config(user=Depends(get_current_user)) -> dict:
    """读取模型中心配置（API Key 掩码）。"""
    return public_view()


@router.put("/models/config")
def api_models_save(payload: dict, user=Depends(get_current_user)) -> dict:
    """保存模型中心配置。body: {providers, pool, default, agent_routes}"""
    try:
        return save_config(payload)
    except OSError as exc:
        raise HTTPException(status_code=500, detail=f"配置写入失败: {exc}") from exc


@router.post("/models/test")
def api_models_test(payload: dict, user=Depends(get_current_user)) -> dict:
    """供应商连通性测试。body: {base_url, api_key?, model?}"""
    base_url = str(payload.get("base_url") or "").strip()
    if not base_url:
        raise HTTPException(status_code=400, detail="base_url 不能为空")
    api_key = _resolve_test_key(base_url, str(payload.get("api_key") or ""))
    return test_connection(base_url, api_key, str(payload.get("model") or ""))


@router.post("/models/validate-pool")
def api_models_validate_pool(user=Depends(get_current_user)) -> dict:
    """池内全部模型可用性验证（红色提示/下拉禁用依据；不影响调用链路）。"""
    return validate_pool_models()


@router.post("/models/discover")
def api_models_discover(payload: dict, user=Depends(get_current_user)) -> dict:
    """拉取供应商模型清单（一键导入模型池）。body: {base_url, api_key?}"""
    base_url = str(payload.get("base_url") or "").strip()
    if not base_url:
        raise HTTPException(status_code=400, detail="base_url 不能为空")
    api_key = _resolve_test_key(base_url, str(payload.get("api_key") or ""))
    return discover_models(base_url, api_key)
